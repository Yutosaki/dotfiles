# ================================
# ble.sh 初期化設定 (必ずファイルの先頭に配置)
# ================================
if [[ $- == *i* && -f ~/.local/share/blesh/ble.sh ]]; then
    source ~/.local/share/blesh/ble.sh --noattach
fi

# macOSでのBashデフォルト警告を非表示にする
export BASH_SILENCE_DEPRECATION_WARNING=1

# ================================
# Bash 基本・補完設定
# ================================
if [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
fi

if [ -z "$TMUX" ]; then
    export TERM=xterm-256color
fi

export EDITOR=vim

bind 'set completion-ignore-case on'
bind 'set show-all-if-ambiguous on'
bind 'set bell-style none'

# キーバインド設定
bind '"\C-h": backward-char'
bind '"\C-j": next-history'
bind '"\C-k": previous-history'

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# ================================
# 履歴設定
# ================================
export HISTFILE=~/.bash_history
export HISTSIZE=1000000
export HISTFILESIZE=1000000

shopt -s histappend
shopt -s cmdhist
export HISTCONTROL=ignorespace:erasedups

# ================================
# man表示・bat設定
# ================================
export MANPAGER="sh -c 'col -bx | bat --theme=TwoDark --paging=always -l man -p'"

man() {
  if [ "$(uname)" = "Darwin" ]; then
    command man "$@"
  else
    command man --no-hyphenation --no-justification "$@"
  fi
}

export BAT_THEME="Dracula"

# ================================
# 共通パス設定
# ================================
export PATH="$PATH:/bin"
export PATH="$PATH:/sbin"
export PATH="$PATH:/usr/bin"
export PATH="$PATH:/usr/sbin"
export PATH="$PATH:/usr/local/bin"
export PATH="$PATH:$HOME/.local/bin"
export PATH="$PATH:$HOME/.npm-global/bin"
export PATH="$PATH:$HOME/.config/nvim"
export PATH="$HOME/bin:$PATH"

export GOPATH="$HOME/Go"
export PATH="$PATH:$GOPATH/bin"

if [ -f "$HOME/.cargo/env" ]; then
    source "$HOME/.cargo/env"
fi

# ================================
# mise (Universal Tool Manager) 設定
# ================================
export PATH="$HOME/.local/bin:$PATH"

if command -v mise &> /dev/null; then
  eval "$(mise activate bash)"
fi

# ================================
# OS別設定
# ================================
case "$(uname -s)" in
    Darwin)
        if [ -f /opt/homebrew/bin/brew ]; then
            eval "$(/opt/homebrew/bin/brew shellenv)"
        fi

        if [ -d "/opt/homebrew/opt/llvm/bin" ]; then
            export PATH="/opt/homebrew/opt/llvm/bin:$PATH"
        fi

        export LDFLAGS="-L/opt/homebrew/opt/icu4c/lib $LDFLAGS"
        export CPPFLAGS="-I/opt/homebrew/opt/icu4c/include $CPPFLAGS"
        export PKG_CONFIG_PATH="/opt/homebrew/opt/icu4c/lib/pkgconfig:$PKG_CONFIG_PATH"

        if [ -d "/usr/local/pgsql/bin" ]; then
            export PATH="/usr/local/pgsql/bin:$PATH"
            export LDFLAGS="-L/usr/local/pgsql/lib $LDFLAGS"
            export CPPFLAGS="-I/usr/local/pgsql/include $CPPFLAGS"
        fi
        ;;
    Linux)
        ;;
esac

# ================================
# エイリアス・関数定義
# ================================
alias ls="lsd --icon never"
alias ll="ls -al"
alias tmp="cd /tmp"
alias tm="tmux"
alias mp="multipass"

if command -v tac >/dev/null 2>&1; then
  alias rtac='tac'
else
  alias rtac='tail -r'
fi

mkcd() {
    mkdir -p "$1" && cd "$1"
}

google(){
    local url="https://google.co.jp/search?q=${*// /+}"
    open -a "Google Chrome" "$url"
}

cd() {
    builtin cd "$@" && {
        if [[ "$PWD" != "$HOME" ]]; then
            lsd --icon=never
        fi
    }
}

# ================================
# プロンプト設定 (bash専用：オレンジベース・ble.sh共存版)
# ================================
set_bash_prompt() {
    local shellName="bash"
    local color_user="208"   
    local color_at="220"     
    local color_host="208"   
    local color_path="215"   
    local color_git="228"    

    local fb sb
    if [[ ${BLE_VERSION-} ]]; then
        fb=""
        sb=""
    else
        fb="\["
        sb="\]"
    fi

    local git_info=""
    if git rev-parse --is-inside-work-tree &>/dev/null; then
        local branch=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)
        local unstaged=""
        local staged=""
        
        git diff --quiet 2>/dev/null || unstaged="${fb}\033[38;5;176m${sb}+"
        git diff --cached --quiet 2>/dev/null || staged="${fb}\033[38;5;228m${sb}!"
        
        git_info="${fb}\033[38;5;${color_git}m${sb}${branch}${staged}${unstaged} "
    fi
    
    PS1="${fb}\033[38;5;${color_user}m${sb}${shellName}${fb}\033[38;5;${color_at}m${sb}@${fb}\033[38;5;${color_host}m${sb}\h ${fb}\033[38;5;${color_path}m${sb}\w ${git_info}${fb}\033[0m${sb}\$ "
}

PROMPT_COMMAND="set_bash_prompt"

# ================================
# fzf 設定 (Ctrl+R 履歴検索カスタムウィジェット)
# ================================
[ -f ~/.fzf.bash ] && source ~/.fzf.bash

export FZF_DEFAULT_COMMAND='history -1000'
export FZF_CTRL_R_OPTS='--height 40% --layout=reverse --preview "echo {}" --preview-window down:3:wrap --bind ctrl-y:execute-silent(echo -n {2..} | pbcopy)'

__fzf_history__() {
    local history_cmd
    if command -v tac >/dev/null 2>&1; then
        history_cmd="tac"
    else
        history_cmd="tail -r"
    fi

    local selected
    history -a
    history -r
    selected=$(history | $history_cmd | fzf --height=40% --layout=reverse \
        --color="fg:#d0d0d0,bg:#1e1e1e,hl:#ffaf00,fg+:#d0d0d0,bg+:#5f00af,hl+:#ffaf00,info:#ffaf00,prompt:#ffaf00,pointer:#ffaf00,marker:#ffaf00,spinner:#ffaf00,header:#ffaf00" \
        --bind "del:abort")
    
    if [[ -n "$selected" ]]; then
        READLINE_LINE=$(echo "$selected" | sed -E 's/^[[:space:]]*[0-9]+[[:space:]]+//')
        READLINE_POINT=${#READLINE_LINE}
    fi

    if [[ ${BLE_VERSION-} ]]; then
        ble/textarea/invalidate
    fi
}

# ================================
# SSH 設定
# ================================
if [ -z "$SSH_AUTH_SOCK" ]; then
   eval "$(ssh-agent -s)" > /dev/null
fi

export APPLE_SSH_ADD_BEHAVIOR=Apple

if [ "$(uname)" = "Darwin" ]; then
    if [ ! -f ~/.ssh/config.Darwin ]; then
        echo 'Match exec "test $(uname) = '\''Darwin'\''"' > ~/.ssh/config.Darwin
        echo '    UseKeychain yes' >> ~/.ssh/config.Darwin
    fi
else
    if [ ! -f ~/.ssh/config.Linux ]; then
        mkdir -p ~/.ssh
        echo '# Linux 専用の設定' > ~/.ssh/config.Linux
    fi
fi

# ================================
# Lima BEGIN / END
# ================================
PATH="$PATH:/usr/sbin:/sbin"
export PATH

# ================================
# 外部設定ファイルの読み込み
# ================================
if [ -f "$HOME/.brewconfig.bash" ]; then
    source "$HOME/.brewconfig.bash"
elif [ -f "$HOME/.brewconfig.zsh" ]; then
    source "$HOME/.brewconfig.zsh"
fi

# ================================
# ble.sh 有効化・挙動カスタマイズ設定
# ================================
if [[ ${BLE_VERSION-} ]]; then
    bleopt prompt_eol_mark=''
    bleopt exec_exit_mark=
    bleopt exec_errexit_mark=
    bleopt exec_elapsed_mark=
    bleopt edit_marker=
    bleopt edit_marker_error=

    # 履歴からのグレーの予測文字（Auto-complete）を有効化
    bleopt complete_auto_complete=1

    # 正しいコマンドを打ったときの色を【緑色】に変更 (zsh再現)
    ble-face command_builtin=fg=green
    ble-face command_file=fg=green
    ble-face command_alias=fg=green
    ble-face command_function=fg=green
    ble-face auto_complete=fg=242

    # 補完モジュール（core-complete）が完全にロードされた後に、中身の処理を確実に実行します
    ble-import core-complete -C '
        bleopt complete_menu_complete_opts=insert-selection:hidden
        ble-bind -f TAB menu-complete
        ble-bind -f C-i menu-complete
        ble-bind -f C-@  "complete toggle_menu"
        ble-bind -f C-SP "complete toggle_menu"
        ble-bind -m menu_complete -f C-@  menu_complete/toggle-hidden
        ble-bind -m menu_complete -f C-SP menu_complete/toggle-hidden

        # 補完システムが起動した後にバインドするため、C-lに「予測があれば一発全確定、
        ble-bind -f C-h backward-char
        ble-bind -f C-l forward-char
    '

    # ble.sh 本体をアタッチ
    ble-attach

    # Ctrl+R の独自fzfウィジェットを登録
    ble-bind -x 'C-r' __fzf_history__
else
    bind -x '"\C-r": __fzf_history__'
    bind '"\C-h": backward-char'
    bind '"\C-l": forward-char'
fi
